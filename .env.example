# Local development settings. Copy to .env (git-ignored) and fill in.
# Variable names and meanings: docs/contracts.md. Never commit real values.

# --- All services --------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
GOOGLE_CLOUD_LOCATION=us-central1

# --- Emulators (local only) ------------------------------------------------------
FIRESTORE_EMULATOR_HOST=localhost:8681
PUBSUB_EMULATOR_HOST=localhost:8682

# --- wa-webhook ------------------------------------------------------------------
# Secret: Meta app secret, used to check X-Hub-Signature-256.
META_APP_SECRET=
# Secret: token you choose and type in Meta's webhook configuration.
META_VERIFY_TOKEN=
WA_INBOUND_TOPIC=wa-inbound

# --- main-worker -----------------------------------------------------------------
# Secret: system user token with whatsapp_business_messaging.
META_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
# Template sent outside the 24 h window; hello_world is the only one on the test number.
WA_ORDER_READY_TEMPLATE=hello_world
WA_TEMPLATE_LANG=en_US
# projects/<PROJECT_NUMBER>/locations/us-central1/reasoningEngines/<ID>
AGENT_RESOURCE_NAME=
FIRESTORE_CHANNEL_DB=channel
MEDIA_BUCKET=<PROJECT_ID>-media
LINK_WEB_URL=http://localhost:8085
SESSION_IDLE_HOURS=24
AUTH_FRESH_HOURS=24
# iam on Cloud Run; local signs HS256 tokens with LOCAL_TOKEN_SECRET. Shared by
# main-worker (signer), mcp-shop and link-web (verifiers): all must use the same mode.
TOKEN_SIGNER=local
# Signer identity, stamped as iss. Its service account e-mail on Cloud Run.
SIGNER_SA_EMAIL=local-signer
# Local only: HS256 key used when TOKEN_SIGNER=local. Any long random string.
LOCAL_TOKEN_SECRET=

# --- mcp-shop --------------------------------------------------------------------
FIRESTORE_SHOP_DB=shop
# Expected iss (also read by link-web): main-worker's service account e-mail on
# Cloud Run; locally it must equal SIGNER_SA_EMAIL.
TOKEN_ISSUER=local-signer
# Secret: production access token of the collecting Mercado Pago account.
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
# mercadopago or simulated
TRANSFER_VERIFIER=simulated
# Optional JSON list of transfers for the simulated verifier (bundled fixture by default).
SIMULATED_TRANSFERS_PATH=
ORDER_CREATED_TOPIC=order-created
EXTRACTION_MODEL=gemini-2.5-flash
CREDIT_LIMIT_CENTS=1000
MATCH_WINDOW_MINUTES=120

# --- image-generator -------------------------------------------------------------
ORDER_READY_TOPIC=order-ready
IMAGE_MODEL=gemini-3.1-flash-lite-image
# Vertex AI location of the image model, independent of GOOGLE_CLOUD_LOCATION.
IMAGE_MODEL_LOCATION=global
DAILY_GENERATION_CAP=200

# --- link-web --------------------------------------------------------------------
# Browser API key of Identity Platform (public by design): terraform state or console.
IDENTITY_API_KEY=
IDENTITY_AUTH_DOMAIN=<PROJECT_ID>.firebaseapp.com

# --- agent -----------------------------------------------------------------------
MCP_SHOP_URL=http://localhost:8083/mcp
AGENT_MODEL=gemini-2.5-flash
